:^instruction is ep_phase=0 & ep_any=0 & instruction [ ep_phase=1; ]
  { build instruction; }
:^instruction is ep_phase=0 & ep_any=1 & ep_cpre=0 & EpSv & EpPo & EpCo & instruction
  [ ep_phase=1; ]
  { build EpSv; build instruction; build EpPo; build EpCo; }
# A branch ending its packet commits first; it never parks writes itself.
:^instruction is ep_phase=0 & ep_any=1 & ep_cpre=1 & EpCo & instruction
  [ ep_phase=1; ]
  { build EpCo; build instruction; }
